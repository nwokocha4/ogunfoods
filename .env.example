# Copy this file to .env.local and fill in your REAL values.
# .env.local stays on your laptop only — it is never committed to git.
# .env.example IS committed, so it must contain placeholder values only.

# Find both values in Supabase: Settings (gear icon) -> API.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=paste-your-anon-public-key-here

# SMS delivery through Termii.
# These are server-only. Never add NEXT_PUBLIC_ to them — that would ship
# the API key to every visitor's browser.
TERMII_API_KEY=paste-your-termii-api-key-here
TERMII_BASE_URL=https://v4.api.termii.com
# The sender name approved on your Termii account (max 11 characters, no spaces).
TERMII_SENDER_ID=paste-your-approved-sender-id-here

# The signing secret from Supabase -> Authentication -> Hooks -> Send SMS.
# Looks like: v1,whsec_xxxxxxxxxxxxxxxx
SEND_SMS_HOOK_SECRET=paste-your-hook-secret-here

# Testing only — no Termii certificate needed. When true, /api/auth/send-sms
# logs the code to the dev-server terminal instead of sending real SMS.
SMS_TEST_MODE=true

# Server-only key used by the 30-minute auto-cancel job. Find it in Supabase
# -> Settings -> API -> service_role. It bypasses row-level security, so it
# must never get a NEXT_PUBLIC_ prefix or appear in browser code.
SUPABASE_SERVICE_ROLE_KEY=paste-your-service-role-key-here

# Shared secret for the auto-cancel cron. Create a long random string.
# Vercel sends it as Authorization: Bearer <secret> when the variable
# is set in the Vercel project (not just in .env.local).
CRON_SECRET=paste-a-long-random-string-here
