# Copy this file to .env.local and fill in your REAL values.
# .env.local stays on your laptop only — it is never committed to git.
# Find the URL and both keys in Supabase: Settings (gear icon) -> API.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=paste-your-anon-public-key-here

# The service role key bypasses Supabase security. It is used only by the
# server-side auto-cancel job and must never be used in a browser component.
SUPABASE_SERVICE_ROLE_KEY=paste-your-service-role-key-here

# Any long random string. The auto-cancel job sends it as a Bearer token;
# Vercel and GitHub Actions need the same value.
CRON_SECRET=paste-your-random-cron-secret-here
